# Settings for ./build.sh. Copy this file to .env and change what you need:
#
#   cp .example.env .env
#
# Every line is optional: anything left empty or commented out uses the
# default shown. .env is gitignored, so your paths stay local.

# Your copy of Kingdom: New Lands (the folder containing Kingdom_Data).
# Empty: search the usual Steam libraries, ~/GOG Games and gamefiles/.
KINGDOM_GAME=

# What to build:
#   desktop  convert the assets and build the desktop (PC) version
#   3ds      ...and kingdom.3dsx for the Homebrew Launcher
#   cia      ...and kingdom.cia for the HOME Menu as well
# Empty: build.sh asks whether you want the .3dsx or the .cia.
TARGET=

# Install missing system packages, Rust and devkitPro (asks for sudo).
# Set to no if you manage the dependencies yourself.
INSTALL_DEPS=yes

# devkitPro's location (default /opt/devkitpro; DEVKITARM defaults to
# $DEVKITPRO/devkitARM).
DEVKITPRO=
DEVKITARM=

# An AssetRipper 2.0.0 executable (AssetRipper.GUI.Free) you already have.
# Empty: download the pinned, checksummed release into tools/assetripper/.
ASSETRIPPER=

# The finished SD card layout is always written to dist/sdcard/. Set this
# to your mounted SD card (e.g. /run/media/$USER/3DS) to also copy it there.
SDCARD=
