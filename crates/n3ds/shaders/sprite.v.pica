; Sprite vertex shader: screen-space position through the screen's
; projection, texture coordinate passed through, byte colour scaled to 0..1.
; The position's w is the item's stereo depth: each eye shifts it by
; depth * eye.x pixels (eye.x is 0 without 3D).

.fvec projection[4]
.fvec eye

.constf ones(1.0, 1.0, 1.0, 1.0)
.constf inv255(0.003921569, 0.003921569, 0.003921569, 0.003921569)

.out outpos position
.out outtc0 texcoord0
.out outclr color

.alias inpos v0
.alias intex v1
.alias inclr v2

.proc main
	mov r0, inpos
	mul r1, eye.xxxx, r0.wwww
	add r0.x, r0.xxxx, r1.xxxx
	mov r0.w, ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intex
	mul outclr, inv255, inclr
	end
.end
